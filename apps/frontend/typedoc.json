{
    "entryPoints": ["src"],
    "entryPointStrategy": "expand",
    "out": "docs",
    "skipErrorChecking": true,
    "compilerOptions": {
        "skipLibCheck": true,
        "noEmit": true
    },
    "name": "Frontend Documentation",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true
}
